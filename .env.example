# MongoDB
# Note: For host runs against the Docker mongo1 container, use directConnection=true
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=reviewguard

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery Broker and Backend
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Model and Tokenizer Paths
MODEL_PATH=models/fusion_model_quantized.onnx
QUANTIZED_MODEL_PATH=models/fusion_model_quantized.onnx
REFERENCE_SCORES_PATH=models/reference_scores.npy
SCALER_PATH=models/scaler.pkl
TOKENIZER_PATH=models/tokenizer

# Scoring Weights & Thresholds
NLP_WEIGHT=0.8
VELOCITY_WEIGHT=0.2
QUARANTINE_THRESHOLD=0.7

# Drift Detection
KS_P_VALUE_THRESHOLD=0.05

# Security & CORS
WEBHOOK_SECRET=changeme-webhook-secret
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Velocity Cache
VELOCITY_TTL=86400
